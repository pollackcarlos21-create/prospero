{
  "name": "prospero",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A permission-first desktop personal agent",
  "license": "MIT",
  "main": "dist/main.cjs",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test packages apps/desktop/src tests/unit",
    "test:acceptance": "bun scripts/acceptance-offline.ts",
    "test:live-dry-run": "bun scripts/acceptance-live-dry-run.ts",
    "build": "bun scripts/build.ts",
    "test:e2e": "playwright test",
    "package": "bun run build && bun scripts/package.ts",
    "smoke:real": "bun scripts/real-smoke.ts",
    "security:audit": "bun scripts/security-audit.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.3.10",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "diff": "9.0.0",
    "@prospero/providers": "workspace:*"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
